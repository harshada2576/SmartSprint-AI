# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Supabase (for Edge Functions, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only: never expose with a NEXT_PUBLIC_ prefix, never import in browser code.
# Required Supabase Dashboard > Authentication > URL Configuration:
#   Site URL = your app origin (e.g. http://localhost:3000)
#   Redirect URLs must include: <site-url>/auth/callback
# Google OAuth additionally requires the Supabase callback URL in
# Google Cloud Console (see Supabase Dashboard > Authentication > Providers > Google).

# AI (for future AI layer)
AI_API_KEY=your-ai-api-key
AI_MODEL=your-model-name

# Optional: Analytics, Monitoring, etc.
# NEXT_PUBLIC_ANALYTICS_ID=
# SENTRY_DSN=